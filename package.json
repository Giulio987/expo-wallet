{
  "name": "@giulio987/expo-wallet",
  "version": "1.0.0",
  "description": "Add, read and manage Apple Wallet and Google Wallet passes from React Native / Expo, built with Nitro Modules",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "specs": "nitrogen",
    "build": "npm run typecheck && bob build",
    "prepublishOnly": "npm run specs && npm run build",
    "clean": "git clean -dfX"
  },
  "keywords": [
    "react-native",
    "expo",
    "nitro",
    "wallet",
    "apple-wallet",
    "google-wallet",
    "passkit"
  ],
  "files": [
    "src",
    "lib",
    "nitrogen",
    "nitro.json",
    "plugin",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "*.podspec",
    "README.md"
  ],
  "repository": "https://github.com/Giulio987/expo-wallet",
  "bugs": {
    "url": "https://github.com/Giulio987/expo-wallet/issues"
  },
  "author": "Giulio Milani <giulio.milani99@gmail.com> (https://github.com/Giulio987)",
  "license": "MIT",
  "homepage": "https://github.com/Giulio987/expo-wallet#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@expo/config-plugins": "^58.0.10",
    "@types/react": "~19.2.0",
    "nitrogen": "^0.37.1",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "^0.37.1",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@expo/config-plugins": "*",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.37.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
